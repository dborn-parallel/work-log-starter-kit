# Settings for the work log. Copy to config.env and fill in. run.sh sources this file and exports
# each variable, so collect.py and the prompts see the same values. Use absolute paths with no
# spaces, because the permission rules of the summarizer contain these paths.

# The name the summarizer uses for you in the summary, and your GitHub login.
WORKLOG_OWNER_NAME="<your name>"
WORKLOG_GITHUB_LOGIN="<your GitHub login>"

# A folder whose direct children are git checkouts. Worktrees of one repository count once.
WORKLOG_REPOS_ROOT="$HOME/<path to your checkouts>"

# GitHub repositories to search for PRs, as owner/name, separated by spaces. Empty turns GitHub off.
WORKLOG_GITHUB_REPOS="<owner>/<repo>"

# The ref that branches are compared against.
WORKLOG_MAIN_REF="origin/main"

# Optional: a scratch folder whose top-level folders hold side work, such as analyses or pages.
# Leave empty to turn it off.
WORKLOG_DEV_DIR=""

# Claude Code transcripts. This default is correct for most installs.
WORKLOG_CLAUDE_PROJECTS="$HOME/.claude/projects"

# Folder name patterns under WORKLOG_CLAUDE_PROJECTS whose sessions go into the summary, separated
# by spaces. Session titles and typed prompts of these projects reach the model, and session titles
# reach the page. "*" takes all projects.
WORKLOG_CLAUDE_PROJECT_GLOBS="*"

# Optional: the Claude memory folder of your main project, which the summarizer reads to write
# better tasks. It is under ~/.claude/projects/<project>/memory. Leave empty to turn it off.
WORKLOG_MEMORY_DIR=""

# Optional: the main checkout that the summarizer may read, with Read, Grep and Glob only, to explain
# CI failures. Leave empty to turn it off.
WORKLOG_SOURCE_DIR=""

# Your Atlassian site, such as example.atlassian.net. Leave empty if you do not use Jira. A site that
# is not on atlassian.net also needs a change to the `link` pattern in schema.json.
WORKLOG_ATLASSIAN_SITE=""

# The local clone of the private repository that the cloud publisher reads. Set after phase 4.
WORKLOG_PUBLISH_REPO=""

# The claude.ai URL of the work log page. Set after the first publish.
WORKLOG_PAGE_URL=""

# Optional: folders to put before PATH, for tools that systemd does not find, such as gh or claude
# installed with snap, Homebrew or npm. Separate folders with ":".
WORKLOG_PATH=""

# Cost caps for one summarizer run, in USD.
WORKLOG_BUDGET_USD=4
WORKLOG_WEEK_BUDGET_USD=6
