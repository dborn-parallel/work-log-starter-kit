[Unit]
Description=Write one work log run and push it to the publish repo
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
# Replace <WORK_LOG_DIR_UNDER_HOME> with the folder of run.sh, relative to your home folder.
ExecStart=%h/<WORK_LOG_DIR_UNDER_HOME>/run.sh
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WORKLOG_LOG_TO_FILE=1
# The run uses your Claude Code login, not an API key from the environment.
UnsetEnvironment=ANTHROPIC_API_KEY
Nice=10
Restart=on-failure
RestartSec=15min
